# Application configuration
APP_NAME=NNY Emergency Dashboard
APP_ENV=development

# Database
DB_HOST=pg
DB_PORT=5432
DB_NAME=nny_em_dashboard
DB_USER=emdash
DB_PASSWORD=emdash_secure_password_change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=change_this_in_production
JWT_ALGORITHM=HS256

# API
API_HOST=0.0.0.0
API_PORT=8000

# SDRtrunk
SDRTRUNK_HOST=sdrrtrunk
SDRTRUNK_PORT=8000
SDRTRUNK_STREAM_URL=tcp://sdrrtrunk:8000/stream

# Transcription
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Celery
CELERY_BROKER=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
